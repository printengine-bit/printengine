# Custom commerce database and signed customer/admin sessions.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/printengine
SESSION_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_SALT=replace-with-a-different-random-secret
NEXT_PUBLIC_SITE_URL=https://printengine.in
ADMIN_EMAIL=admin@printengine.in
ADMIN_PASSWORD=replace-before-running-the-seed

# Direct Razorpay checkout. Secrets stay server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Real AI artwork generation. Keep this server-side only.
OPENAI_API_KEY=

# Durable, access-controlled customer artwork storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Newsletter, bulk-quote and support intake (Shopify Flow, Klaviyo, Zapier, etc.).
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=

# Optional fulfilment and transactional messaging.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_PACKAGE_LENGTH_CM=
SHIPROCKET_PACKAGE_BREADTH_CM=
SHIPROCKET_PACKAGE_HEIGHT_CM=
SHIPROCKET_ITEM_WEIGHT_KG=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=PrintEngine <orders@printengine.in>
EMAIL_REPLY_TO=support@printengine.in

# Never enable sample customers, scarcity or reviews in production.
NEXT_PUBLIC_ENABLE_DEMO_DATA=false

# Publish only verified business details.
NEXT_PUBLIC_GSTIN=
